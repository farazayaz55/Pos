# Firebase Web App config (Project settings -> General -> Your apps -> SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# ---- Firebase Emulator Suite ----
# Set to true to route Auth / RTDB / Storage / Functions calls to the local
# emulators (firebase emulators:start). Leave blank or set to false to use prod.
VITE_USE_EMULATOR=false

# Optional emulator host + ports (defaults shown). Only used when
# VITE_USE_EMULATOR=true. Must match the ports in firebase.json.
VITE_EMULATOR_HOST=127.0.0.1
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_DATABASE_PORT=9000
VITE_EMULATOR_STORAGE_PORT=9199
VITE_EMULATOR_FUNCTIONS_PORT=5001
