{
  "name": "pos-mvp",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "emulators": "firebase emulators:start",
    "emulators:functions": "npm --prefix functions run build && firebase emulators:start --only auth,database,storage,functions",
    "emulators:core": "firebase emulators:start --only auth,database",
    "seed:super-admin": "npm --prefix functions run seed:super-admin",
    "grant:public": "npm --prefix functions run grant:public",
    "deploy:rules": "firebase deploy --only database,storage",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "npm run build && firebase deploy",
    "storage:cors": "gcloud storage buckets update gs://servr-7d3f7.firebasestorage.app --cors-file=storage-cors.json",
    "electron:compile": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('electron-dist/package.json', JSON.stringify({type:'commonjs'}))\"",
    "electron:dev": "npm run electron:compile && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "electron:build": "cross-env ELECTRON=true npm run build && npm run electron:compile && electron-builder",
    "electron:build:mac": "cross-env ELECTRON=true npm run build && npm run electron:compile && electron-builder --mac",
    "electron:build:win": "cross-env ELECTRON=true npm run build && npm run electron:compile && electron-builder --win",
    "electron:publish": "cross-env ELECTRON=true npm run build && npm run electron:compile && electron-builder --publish always"
  },
  "build": {
    "appId": "com.posmvp.desktop",
    "productName": "Restaurant POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "farazayaz55",
        "repo": "Pos",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "electron-updater": "^6.8.9",
    "firebase": "^10.13.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wait-on": "^8.0.2"
  }
}
